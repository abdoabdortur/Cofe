<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Study & Work Café 3D</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { overflow: hidden; background: #0f172a; color: #fff; font-family: sans-serif; }
    #canvas-container { width: 100vw; height: 100vh; }
    #ui {
      position: absolute; top: 10px; right: 10px; left: 10px;
      background: rgba(15, 23, 42, 0.85); padding: 12px; border-radius: 10px;
      backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.1);
      display: flex; flex-direction: column; gap: 8px; font-size: 12px;
    }
    .btns { display: flex; gap: 6px; }
    button {
      flex: 1; background: #0284c7; color: #fff; border: none;
      padding: 8px; border-radius: 6px; font-size: 12px; font-weight: bold;
    }
  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
</head>
<body>

  <div id="ui">
    <div style="font-weight:bold; color:#38bdf8; font-size:14px;">Study & Work Café 3D</div>
    <div>المقهى العام بالأسفل (بني) | الـ VIP بالأعلى (أزرق وبنفسجي)</div>
    <div class="btns">
      <button onclick="setView(1)">الدور الأول</button>
      <button onclick="setView(2)">الدور الثاني VIP</button>
      <button onclick="setView(0)">عرض كامل</button>
    </div>
  </div>

  <div id="canvas-container"></div>

  <script>
    let scene, camera, renderer, controls;

    function init() {
      const container = document.getElementById('canvas-container');
      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x0f172a);

      camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(20, 16, 20);

      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      container.appendChild(renderer.domElement);

      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;

      const light1 = new THREE.AmbientLight(0xffffff, 0.7);
      scene.add(light1);
      const light2 = new THREE.DirectionalLight(0xffffff, 0.8);
      light2.position.set(10, 20, 10);
      scene.add(light2);

      // Floor 1 (Café)
      const f1 = new THREE.Mesh(new THREE.BoxGeometry(12, 0.3, 8), new THREE.MeshStandardMaterial({ color: 0x8b5a2b }));
      scene.add(f1);

      // Bar
      const bar = new THREE.Mesh(new THREE.BoxGeometry(3.5, 1, 1.2), new THREE.MeshStandardMaterial({ color: 0x334155 }));
      bar.position.set(-3, 0.65, -2.5);
      scene.add(bar);

      // Floor 2 (VIP)
      const f2 = new THREE.Mesh(new THREE.BoxGeometry(12, 0.3, 8), new THREE.MeshStandardMaterial({ color: 0x1e293b }));
      f2.position.y = 3.8;
      scene.add(f2);

      // Pods
      for(let x = -4; x <= -1; x += 1.5) {
        const pod = new THREE.Mesh(new THREE.BoxGeometry(1.2, 1.8, 1.5), new THREE.MeshStandardMaterial({ color: 0x0284c7 }));
        pod.position.set(x, 4.85, -2.5);
        scene.add(pod);
      }

      // Group Room
      const room = new THREE.Mesh(new THREE.BoxGeometry(3, 2, 3), new THREE.MeshStandardMaterial({ color: 0x7e22ce }));
      room.position.set(3.5, 4.95, -2);
      scene.add(room);

      // Meeting Room
      const conf = new THREE.Mesh(new THREE.BoxGeometry(4, 2, 3), new THREE.MeshStandardMaterial({ color: 0x0f766e }));
      conf.position.set(3, 4.95, 2);
      scene.add(conf);

      // Stairs
      for(let i = 0; i < 10; i++) {
        const st = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.3, 0.4), new THREE.MeshStandardMaterial({ color: 0x64748b }));
        st.position.set(-5, i * 0.35 + 0.2, (i * 0.35) - 1);
        scene.add(st);
      }

      animate();
    }

    function setView(f) {
      if(f === 1) { camera.position.set(0, 4, 12); controls.target.set(0, 1, 0); }
      else if(f === 2) { camera.position.set(0, 8, 12); controls.target.set(0, 5, 0); }
      else { camera.position.set(20, 16, 20); controls.target.set(0, 2, 0); }
      controls.update();
    }

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }

    window.onload = init;
  </script>
</body>
</html>
